# Maintainer: Syno Companion contributors
# The binary package of a GitHub release; tools/update-packaging.mjs sets the
# version and checksums after a release.
pkgname=syno-companion-bin
pkgver=0.2.0
pkgrel=1
pkgdesc='Desktop companion for Synology NAS'
arch=('x86_64' 'aarch64')
url='https://github.com/SoulInfernoDE/synology-companion-app'
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator')
optdepends=('gnome-keyring: keychain for passwords and SSH keys'
            'kwallet: keychain for passwords and SSH keys on KDE')
provides=('syno-companion')
conflicts=('syno-companion')
source_x86_64=("$url/releases/download/v$pkgver/syno-companion_${pkgver}_amd64.deb")
source_aarch64=("$url/releases/download/v$pkgver/syno-companion_${pkgver}_arm64.deb")
sha256sums_x86_64=('a8b03784f5b57e736fb2e7ad690caf789c397de5bceb795cc4a1cfbc72893f0b')
sha256sums_aarch64=('9d5b5cc017b15259239bdf3d72b2e407ebf0b96389445f931a2b37723bd14765')

package() {
  tar -xf data.tar.* -C "$pkgdir"
}
